GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
# FACE_DETECTOR_MODEL_PATH=
# FACE_EMBEDDER_MODEL_PATH=
# FACE_LIVENESS_MODEL_PATH=

NODE_ENV=
REDIS_ENABLED=
REDIS_HOST=
REDIS_PORT=
OAUTH_SESSION_SECRET=

AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=

# Local Redis (docker maps redis to 127.0.0.1:6379)
REDIS_URL=

# SMS Gateway (Eskiz.uz / PlayMobile.uz / STUB)
# PRODUCTION: STUB is rejected at boot (fail-fast). Set Eskiz
# (ESKIZ_EMAIL/ESKIZ_PASSWORD) or PlayMobile (PLAYMOBILE_BASE_URL/PLAYMOBILE_TOKEN).
# STUB remains valid for development/test (no real gateway needed).
SMS_PROVIDER=STUB
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
PLAYMOBILE_BASE_URL=
PLAYMOBILE_TOKEN=

# Email / SMTP Delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="M-EDU Platform <no-reply@m-edu.uz>"

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# IP Camera / RTSP Streaming
RTSP_TRANSPORT=tcp
FFMPEG_PATH=ffmpeg
ONVIF_DISCOVERY_TIMEOUT_MS=5000
