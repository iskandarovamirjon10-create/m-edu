{
  "name": "@medu/api",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 nest build && node scripts/copy-assets.js",
    "dev": "nest start --watch",
    "db:dev": "tsx scripts/start-dev-db.ts",
    "start:prod": "node --max-old-space-size=4096 dist/main",
    "db:migrate:deploy": "prisma migrate deploy",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "typecheck": "node --max-old-space-size=4096 ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "test": "vitest run src",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "db:seed": "prisma db seed",
    "db:seed:reset": "prisma db push --force-reset && prisma db seed",
    "test:e2e": "vitest run test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@aws-sdk/s3-request-presigner": "^3.1139.0",
    "@google/genai": "^2.24.0",
    "@medu/camera-engine": "*",
    "@medu/contracts": "*",
    "@medu/core": "*",
    "@medu/face-engine": "*",
    "@medu/face-security": "*",
    "@medu/financial-engine": "*",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^10.4.22",
    "@prisma/client": "^5.20.0",
    "@types/pdfmake": "^0.3.3",
    "@willsoto/nestjs-prometheus": "^6.1.1",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.8",
    "bullmq": "^6.3.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pdfmake": "^0.3.11",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.22",
    "@swc/core": "^1.16.2",
    "@swc/helpers": "^0.5.23",
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/socket.io": "^3.0.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "embedded-postgres": "16.14.0-beta.17",
    "prisma": "^5.20.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.13",
    "typescript": "^5.5.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
