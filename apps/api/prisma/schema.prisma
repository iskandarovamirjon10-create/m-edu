/// Lifecycle of ONE channel delivery attempt for a notification event.
///
/// `DEFERRED` is the quiet-hours state: the notification was NOT dropped, it is
/// waiting for `deferredUntil` and is re-delivered by the sweep job.
/// `SKIPPED` records a deliberate policy decision (channel disabled, no active
/// Telegram account) and is never retried.
enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
  DEFERRED
}

