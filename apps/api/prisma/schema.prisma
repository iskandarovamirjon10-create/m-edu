generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

model Organization {
  id                      String                    @id @default(uuid()) @db.Uuid
  name                    String
  email                   String
  phone                   String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  timezone                String?                   @default("Asia/Tashkent")
  language                String?                   @default("en")
  currency                String?                   @default("UZS")
  logoUrl                 String?
  address                 String?
  website                 String?
  subscriptionId          String?                   @db.Uuid
  settings                Json?
  AiAction                AiAction[]
  AiConversation          AiConversation[]
  AiMessage               AiMessage[]
  Announcement            Announcement[]
  ApiKey                  ApiKey[]
  Assignment              Assignment[]
  attendance              Attendance[]
  auditLogs               AuditLog[]
  branches                Branch[]
  CalendarEvent           CalendarEvent[]
  cameras                 Camera[]
  cameraAttendanceEvents  CameraAttendanceEvent[]
  certificates            Certificate[]
  certificateTemplates    CertificateTemplate[]
  chatConversations       ChatConversation[]
  ChatMessage             ChatMessage[]
  courses                 Course[]
  Curriculum              Curriculum[]
  customRoles             CustomRole[]
  DataExportLog           DataExportLog[]
  deviceTokens            DeviceToken[]
  Discount                Discount[]
  emailLogs               EmailLog[]
  emailTemplates          EmailTemplate[]
  employees               Employee[]
  exams                   Exam[]
  ExamResult              ExamResult[]
  expenses                Expense[]
  faceAuditEvents         FaceAuditEvent[]
  faceDevices             FaceDevice[]
  faceDeviceCredentials   FaceDeviceCredential[]
  faceEnrollments         FaceEnrollment[]
  faceTemplates           FaceTemplate[]
  followUps               FollowUp[]
  grades                  Grade[]
  groups                  Group[]
  homework                Homework[]
  HomeworkSubmission      HomeworkSubmission[]
  inventoryItems          InventoryItem[]
  InventoryTransaction    InventoryTransaction[]
  Invitation              Invitation[]
  Invoice                 Invoice[]
  leads                   Lead[]
  LeaveRequest            LeaveRequest[]
  Lesson                  Lesson[]
  libraryBooks            LibraryBook[]
  LibraryBorrow           LibraryBorrow[]
  Material                Material[]
  MaterialFolder          MaterialFolder[]
  notifications           Notification[]
  notificationDeliveries  NotificationDelivery[]
  branding                OrganizationBranding?
  holidays                OrganizationHoliday[]
  parentAccounts          ParentAccount[]
  ParentSession           ParentSession[]
  ParentTeacherMessage    ParentTeacherMessage[]
  payments                Payment[]
  paymentTransactions     PaymentTransaction[]
  PayrollRun              PayrollRun[]
  Question                Question[]
  Quiz                    Quiz[]
  QuizAttempt             QuizAttempt[]
  recognitionAttempts     RecognitionAttempt[]
  recognitionSessions     RecognitionSession[]
  refunds                 Refund[]
  reports                 Report[]
  smsLogs                 SMSLog[]
  SalaryRecord            SalaryRecord[]
  sessions                Session[]
  students                Student[]
  StudentGamification     StudentGamification[]
  StudentObjectiveMastery StudentObjectiveMastery[]
  StudentProgressSnapshot StudentProgressSnapshot[]
  Subject                 Subject[]
  subscription            Subscription?
  teachers                Teacher[]
  telegramAccounts        TelegramAccount[]
  telegramLinkTokens      TelegramLinkToken[]
  users                   User[]

  @@index([email])
}

model User {
  id                                                             String                   @id @default(uuid()) @db.Uuid
  organizationId                                                 String                   @db.Uuid
  email                                                          String                   @unique
  passwordHash                                                   String?
  firstName                                                      String
  lastName                                                       String
  phone                                                          String?
  avatar                                                         String?
  role                                                           Role                     @default(STUDENT)
  isActive                                                       Boolean                  @default(true)
  provider                                                       String?                  @default("local")
  googleSubject                                                  String?                  @unique
  googleEmail                                                    String?
  lastLoginAt                                                    DateTime?
  createdAt                                                      DateTime                 @default(now())
  updatedAt                                                      DateTime                 @updatedAt
  /// @deprecated Delivery-pointer mirror of `TelegramAccount.chatId`, kept in
  /// sync by TelegramLinkService so the existing notification worker keeps
  /// delivering during the migration. `TelegramAccount` is the source of
  /// truth for Telegram identity/lifecycle; read that model in new code.
  telegramChatId                                                 String?                  @unique
  /// @deprecated Superseded by `TelegramLinkToken` (hash-stored, single-use).
  /// Retained for backwards compatibility; no longer written by the linking flow.
  telegramLinkToken                                              String?                  @unique
  /// @deprecated See `telegramLinkToken`.
  telegramLinkExpiresAt                                          DateTime?
  /// Audit P0-2 — account-model opt-in for Google sign-in.
  ///
  /// Automatic Google linking on a verified-email match is disabled for every
  /// privileged role regardless of this flag. For non-privileged accounts
  /// (STUDENT / PARENT) linking only happens when this flag is explicitly
  /// true, i.e. "explicitly allowed by the account model".
  googleLinkAllowed                                              Boolean                  @default(false)
  status                                                         UserStatus               @default(ACTIVE)
  AccessRequest                                                  AccessRequest[]
  AiAction                                                       AiAction[]
  AiConversation                                                 AiConversation[]
  Announcement                                                   Announcement[]
  AnnouncementRead                                               AnnouncementRead[]
  apiKeysCreated                                                 ApiKey[]
  authorizationCodes                                             AuthorizationCode[]
  automationRulesCreated                                         AutomationRule[]
  Branch                                                         Branch[]
  CalendarEvent                                                  CalendarEvent[]
  ChatMessage                                                    ChatMessage[]
  ChatParticipant                                                ChatParticipant[]
  DataExportLog                                                  DataExportLog[]
  DeviceToken                                                    DeviceToken[]
  Employee                                                       Employee?
  faceAuditEvents                                                FaceAuditEvent[]
  financialPeriodsClosed                                         FinancialPeriod[]
  inventoryTransactions                                          InventoryTransaction[]
  Invitation                                                     Invitation[]
  notifications                                                  Notification[]
  NotificationPreference                                         NotificationPreference[]
  parentStudents                                                 ParentStudent[]
  ParentTeacherMessage_ParentTeacherMessage_receiverUserIdToUser ParentTeacherMessage[]   @relation("ParentTeacherMessage_receiverUserIdToUser")
  ParentTeacherMessage_ParentTeacherMessage_senderUserIdToUser   ParentTeacherMessage[]   @relation("ParentTeacherMessage_senderUserIdToUser")
  passwordResetTokens                                            PasswordResetToken[]
  sessions                                                       Session[]
  student                                                        Student?
  teacher                                                        Teacher?
  telegramAccounts                                               TelegramAccount[]
  organization                                                   Organization             @relation(fields: [organizationId], references: [id])
  userRoles                                                      UserRole[]
  settings                                                       UserSettings?

  @@index([organizationId])
  @@index([email(ops: raw("gin_trgm_ops"))], map: "user_email_trgm_idx", type: Gin)
  @@index([firstName(ops: raw("gin_trgm_ops"))], map: "user_first_name_trgm_idx", type: Gin)
  @@index([lastName(ops: raw("gin_trgm_ops"))], map: "user_last_name_trgm_idx", type: Gin)
  @@index([phone(ops: raw("gin_trgm_ops"))], map: "user_phone_trgm_idx", type: Gin)
  @@index([status])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model AuthorizationCode {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique
  /// @deprecated Legacy column that used to persist the issued JWT verbatim.
  /// Kept readable for rows created before the session-binding migration, but
  /// no longer written: a bearer token at rest is a usable credential for its
  /// whole JWT lifetime even after this row is purged. The session id below is
  /// what identifies the pre-created session; the JWT is re-signed from it at
  /// redemption time.
  accessToken String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  userId      String    @db.Uuid
  /// Session pre-created by `issueToken` during the OAuth callback. Binding the
  /// code to a session means the exchange mints a token for an existing,
  /// revocable session row instead of trusting stored credential material.
  sessionId   String?   @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([expiresAt])
  @@index([userId])
}

model UserSettings {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @db.Uuid
  theme                 String?  @default("light")
  language              String?  @default("en")
  timezone              String?  @default("UTC")
  emailNotifications    Boolean? @default(true)
  pushNotifications     Boolean? @default(true)
  smsNotifications      Boolean? @default(false)
  /// Quiet hours: while inside the window Telegram delivery is DEFERRED (never
  /// dropped). `quietHoursStart`/`End` are wall-clock `HH:mm` in `timezone`
  /// (falling back to the organization timezone, then UTC). Equal start/end
  /// means "no quiet window".
  quietHoursEnabled     Boolean  @default(false)
  quietHoursEnd         String?
  quietHoursStart       String?
  /// Telegram channel opt-in (self-service). Server is the source of truth:
  /// the notification worker reads this flag, never a Telegram-side value.
  telegramNotifications Boolean? @default(true)
  user                  User     @relation(fields: [userId], references: [id])
}

model Session {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  organizationId String       @db.Uuid
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedReason  String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([expiresAt])
}

model Student {
  branchId                String?                   @db.Uuid
  id                      String                    @id @default(uuid()) @db.Uuid
  organizationId          String                    @db.Uuid
  userId                  String                    @unique @db.Uuid
  dateOfBirth             DateTime?
  gender                  Gender?
  address                 String?
  notes                   String?
  parentName              String?
  parentPhone             String?
  parentEmail             String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  status                  StudentStatus             @default(ACTIVE)
  balance                 Decimal                   @default(0) @db.Decimal(12, 2)
  discount                Decimal?                  @db.Decimal(5, 2)
  emergencyContact        String?
  enrollmentDate          DateTime?
  nationality             String?
  AssignmentSubmission    AssignmentSubmission[]
  attendance              Attendance[]
  cameraAttendanceEvents  CameraAttendanceEvent[]
  Certificate             Certificate[]
  Discount                Discount[]
  ExamResult              ExamResult[]
  faceEnrollments         FaceEnrollment[]
  faceTemplates           FaceTemplate[]
  xpEvents                GamificationXpEvent[]
  grades                  Grade[]
  homeworkSubmissions     HomeworkSubmission[]
  Invoice                 Invoice[]
  LibraryBorrow           LibraryBorrow[]
  parentStudents          ParentStudent[]
  ParentTeacherMessage    ParentTeacherMessage[]
  payments                Payment[]
  QuizAttempt             QuizAttempt[]
  recognitionAttempts     RecognitionAttempt[]
  branch                  Branch?                   @relation(fields: [branchId], references: [id])
  organization            Organization              @relation(fields: [organizationId], references: [id])
  user                    User                      @relation(fields: [userId], references: [id])
  StudentGamification     StudentGamification?
  groups                  StudentGroup[]
  StudentObjectiveMastery StudentObjectiveMastery[]
  StudentProgressSnapshot StudentProgressSnapshot[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([branchId])
}

model Teacher {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @db.Uuid
  userId          String          @unique @db.Uuid
  specializations String[]
  hourlyRate      Decimal?        @db.Decimal(10, 2)
  bio             String?
  experience      Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  lessonRate      Decimal?        @db.Decimal(10, 2)
  salaryType      SalaryType      @default(MONTHLY)
  employeeId      String?         @unique @db.Uuid
  CalendarEvent   CalendarEvent[]
  groups          Group[]
  Lesson          Lesson[]
  PayrollRun      PayrollRun[]
  Employee        Employee?       @relation(fields: [employeeId], references: [id])
  organization    Organization    @relation(fields: [organizationId], references: [id])
  user            User            @relation(fields: [userId], references: [id])

  @@index([organizationId])
}

model Course {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  name           String
  description    String?
  price          Decimal        @db.Decimal(12, 2)
  duration       Int
  level          String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  Announcement   Announcement[]
  Certificate    Certificate[]
  organization   Organization   @relation(fields: [organizationId], references: [id])
  Curriculum     Curriculum[]
  Discount       Discount[]
  groups         Group[]
  Subject        Subject[]

  @@index([organizationId])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "course_name_trgm_idx", type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], map: "course_description_trgm_idx", type: Gin)
}

model Group {
  id                     String                  @id @default(uuid()) @db.Uuid
  organizationId         String                  @db.Uuid
  name                   String
  courseId               String                  @db.Uuid
  teacherId              String?                 @db.Uuid
  capacity               Int?                    @default(20)
  room                   String?
  startDate              DateTime?
  endDate                DateTime?
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  branchId               String?                 @db.Uuid
  Announcement           Announcement[]
  Assignment             Assignment[]
  attendance             Attendance[]
  CalendarEvent          CalendarEvent[]
  cameraAttendanceEvents CameraAttendanceEvent[]
  Discount               Discount[]
  Exam                   Exam[]
  grades                 Grade[]
  Branch                 Branch?                 @relation(fields: [branchId], references: [id])
  course                 Course                  @relation(fields: [courseId], references: [id])
  organization           Organization            @relation(fields: [organizationId], references: [id])
  teacher                Teacher?                @relation(fields: [teacherId], references: [id])
  homework               Homework[]
  Lesson                 Lesson[]
  Quiz                   Quiz[]
  recognitionSessions    RecognitionSession[]
  schedules              Schedule[]
  enrollments            StudentGroup[]

  @@index([organizationId])
  @@index([courseId])
  @@index([teacherId])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "group_name_trgm_idx", type: Gin)
  @@index([branchId])
}

model StudentGroup {
  organizationId String    @db.Uuid
  studentId      String    @db.Uuid
  groupId        String    @db.Uuid
  isActive       Boolean   @default(true)
  joinedAt       DateTime  @default(now())
  leftAt         DateTime?
  group          Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([studentId, groupId])
  @@index([groupId])
  @@index([studentId])
}

model Schedule {
  id        String    @id @default(uuid()) @db.Uuid
  groupId   String    @db.Uuid
  dayOfWeek DayOfWeek
  startTime String
  endTime   String
  room      String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  Lesson    Lesson[]
  group     Group     @relation(fields: [groupId], references: [id])

  @@index([groupId])
}

/// Note: Attendance is currently granular to the (student, group, date) level.
/// If a group has multiple lessons per day, attendance will only be recorded once per day.
model Attendance {
  id                   String           @id @default(uuid()) @db.Uuid
  organizationId       String           @db.Uuid
  studentId            String           @db.Uuid
  groupId              String           @db.Uuid
  date                 DateTime
  status               AttendanceStatus @default(PRESENT)
  source               String           @default("MANUAL")
  note                 String?
  confidence           Decimal?         @db.Decimal(6, 4)
  similarityScore      Decimal?         @db.Decimal(6, 4)
  deviceId             String?
  cameraId             String?
  recognitionAttemptId String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  lessonId             String?          @db.Uuid
  group                Group            @relation(fields: [groupId], references: [id])
  lesson               Lesson?          @relation(fields: [lessonId], references: [id])
  organization         Organization     @relation(fields: [organizationId], references: [id])
  student              Student          @relation(fields: [studentId], references: [id])

  @@unique([studentId, groupId, date])
  @@index([organizationId])
  @@index([organizationId, date])
  @@index([studentId])
  @@index([groupId])
  @@index([groupId, date])
  @@index([date])
  @@index([lessonId])
}

model Payment {
  id              String               @id @default(uuid()) @db.Uuid
  organizationId  String               @db.Uuid
  studentId       String               @db.Uuid
  amount          Decimal              @db.Decimal(12, 2)
  status          PaymentStatus        @default(PENDING)
  description     String?
  dueDate         DateTime?
  method          String?
  reference       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  invoiceId       String?              @db.Uuid
  receiptNumber   String?
  receiptIssuedAt DateTime?
  paidAt          DateTime?
  Invoice         Invoice?             @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  organization    Organization         @relation(fields: [organizationId], references: [id])
  student         Student              @relation(fields: [studentId], references: [id])
  transactions    PaymentTransaction[]
  refunds         Refund[]

  @@unique([organizationId, reference])
  @@unique([organizationId, receiptNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([studentId])
  @@index([invoiceId])
  @@index([reference])
  @@index([description(ops: raw("gin_trgm_ops"))], map: "payment_description_trgm_idx", type: Gin)
  @@index([reference(ops: raw("gin_trgm_ops"))], map: "payment_reference_trgm_idx", type: Gin)
}

model Expense {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  category       ExpenseCategory
  amount         Decimal         @db.Decimal(12, 2)
  description    String?
  date           DateTime
  receipt        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([organizationId, date])
}

model Lead {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  firstName      String
  lastName       String?
  phone          String?
  email          String?
  source         String?
  stage          LeadStage      @default(NEW)
  lostReason     String?
  notes          String?
  ownerId        String?        @db.Uuid
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  followUps      FollowUp[]
  organization   Organization   @relation(fields: [organizationId], references: [id])
  activities     LeadActivity[]

  @@index([organizationId])
  @@index([organizationId, stage])
  @@index([ownerId])
  @@index([firstName(ops: raw("gin_trgm_ops"))], map: "lead_first_name_trgm_idx", type: Gin)
  @@index([lastName(ops: raw("gin_trgm_ops"))], map: "lead_last_name_trgm_idx", type: Gin)
  @@index([email(ops: raw("gin_trgm_ops"))], map: "lead_email_trgm_idx", type: Gin)
  @@index([phone(ops: raw("gin_trgm_ops"))], map: "lead_phone_trgm_idx", type: Gin)
}

model LeadActivity {
  id          String           @id @default(uuid()) @db.Uuid
  leadId      String           @db.Uuid
  type        LeadActivityType
  subject     String
  description String?
  outcome     String?
  createdAt   DateTime         @default(now())
  lead        Lead             @relation(fields: [leadId], references: [id])

  @@index([leadId])
}

model FollowUp {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  leadId         String       @db.Uuid
  scheduledAt    DateTime
  isCompleted    Boolean      @default(false)
  note           String?
  createdAt      DateTime     @default(now())
  lead           Lead         @relation(fields: [leadId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([leadId])
}

model Notification {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  organizationId String       @db.Uuid
  title          String
  message        String
  type           String       @default("info")
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([organizationId])
}

model Grade {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  studentId      String       @db.Uuid
  groupId        String       @db.Uuid
  value          Float
  maxValue       Float?       @default(100)
  label          String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  group          Group        @relation(fields: [groupId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  student        Student      @relation(fields: [studentId], references: [id])

  @@index([organizationId])
  @@index([studentId])
  @@index([groupId])
  @@index([studentId, groupId])
}

model Homework {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  groupId        String               @db.Uuid
  title          String
  description    String?
  deadline       DateTime?
  maxScore       Float?               @default(100)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  group          Group                @relation(fields: [groupId], references: [id])
  organization   Organization         @relation(fields: [organizationId], references: [id])
  submissions    HomeworkSubmission[]

  @@index([organizationId])
  @@index([groupId])
}

model FaceEnrollment {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  studentId        String           @db.Uuid
  enrolledBy       String?          @db.Uuid
  status           EnrollmentStatus @default(PENDING)
  enrolledAt       DateTime         @default(now())
  activatedAt      DateTime?
  revokedAt        DateTime?
  revokedBy        String?
  revocationReason String?
  metadata         Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  organization     Organization     @relation(fields: [organizationId], references: [id])
  student          Student          @relation(fields: [studentId], references: [id])
  faceTemplates    FaceTemplate[]

  @@index([organizationId])
  @@index([studentId])
}

model FaceTemplate {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  enrollmentId   String         @db.Uuid
  studentId      String         @db.Uuid
  templateData   String
  templateHash   String
  version        Int            @default(1)
  status         TemplateStatus @default(ACTIVE)
  modelVersion   String?
  qualityScore   Decimal?       @db.Decimal(6, 4)
  enrolledAt     DateTime       @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  enrollment     FaceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id])
  student        Student        @relation(fields: [studentId], references: [id])

  @@index([organizationId])
  @@index([studentId])
  @@index([enrollmentId])
}

model RecognitionSession {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @db.Uuid
  deviceId       String?
  actorId        String?                  @db.Uuid
  groupId        String?                  @db.Uuid
  lessonId       String?
  status         RecognitionSessionStatus @default(STARTED)
  startedAt      DateTime                 @default(now())
  endedAt        DateTime?
  metadata       Json?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  attempts       RecognitionAttempt[]
  group          Group?                   @relation(fields: [groupId], references: [id])
  organization   Organization             @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([groupId])
}

model RecognitionAttempt {
  id                  String                   @id @default(uuid()) @db.Uuid
  organizationId      String                   @db.Uuid
  sessionId           String                   @db.Uuid
  identifiedStudentId String?                  @db.Uuid
  actorId             String?                  @db.Uuid
  status              RecognitionAttemptStatus
  confidence          Decimal?                 @db.Decimal(6, 4)
  qualityScore        Decimal?                 @db.Decimal(6, 4)
  livenessResult      String?
  similarityScore     Decimal?                 @db.Decimal(6, 4)
  processingTimeMs    Int?
  metadata            Json?
  occurredAt          DateTime                 @default(now())
  createdAt           DateTime                 @default(now())
  student             Student?                 @relation(fields: [identifiedStudentId], references: [id])
  organization        Organization             @relation(fields: [organizationId], references: [id])
