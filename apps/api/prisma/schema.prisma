/// Durable M-EDU <-> Telegram identity link (external, untrusted channel).
///
/// This is a mapping of an EXTERNAL identity onto an existing M-EDU principal,
/// not a source of business truth and not an authorization grant. Every
/// request that arrives from Telegram re-resolves `organizationId` / role /
/// permissions from the M-EDU tables — the Telegram side is never trusted.
///
/// Bot secrets and message payloads are never stored here. `telegramUserId`
/// and `chatId` are Telegram int64 values persisted as strings (they overflow
/// a 32-bit integer and are not safe as JS `number`). A single central M-EDU
/// bot is assumed, so both are globally unique: one Telegram identity maps to
/// at most one M-EDU principal.
model TelegramAccount {
  id              String                @id @default(uuid()) @db.Uuid
  organizationId  String                @db.Uuid
  /// Telegram numeric user id (int64), stored as a string for safety.
  telegramUserId  String                @unique
  /// Private chat id with the M-EDU bot (equals telegramUserId for DMs).
  chatId          String                @unique
  username        String?
  firstName       String?
  lastName        String?
  languageCode    String?
  status          TelegramAccountStatus @default(ACTIVE)
  userId          String?               @db.Uuid
  parentAccountId String?               @db.Uuid
  linkedAt        DateTime              @default(now())
  lastSeenAt      DateTime?
  disconnectedAt  DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  organization    Organization          @relation(fields: [organizationId], references: [id])
  parentAccount   ParentAccount?        @relation(fields: [parentAccountId], references: [id])
  user            User?                 @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([parentAccountId])
  @@index([status])
}

/// Short-lived, single-use, hash-stored account-linking token.
///
/// Only the SHA-256 hash is persisted (mirrors `PasswordResetToken`) so a
/// database dump can never be replayed to hijack a link. Consumption is
/// atomic: a conditional `updateMany` on `usedAt IS NULL` guarantees exactly
/// one of several concurrent webhook deliveries (possibly on different API
/// instances) succeeds.
model TelegramLinkToken {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  /// SHA-256 hex of the opaque token handed to the user. Never the raw value.
  tokenHash       String       @unique
  /// 'USER' | 'PARENT_ACCOUNT' — which principal table the link targets.
  targetType      String
  userId          String?      @db.Uuid
  parentAccountId String?      @db.Uuid
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id])

  @@index([expiresAt])
  @@index([organizationId])
  @@index([usedAt])
}

/// Webhook update deduplication ledger.
///
/// Telegram retries webhook deliveries and may deliver the same `update_id` to
/// several API instances. The primary key makes "process exactly once" a
/// database guarantee instead of a process-local one. Rows are metadata only
/// (no payloads) and are subject to the retention policy in docs/TELEGRAM.md.
model TelegramUpdate {
  updateId   BigInt   @id
  receivedAt DateTime @default(now())
  status     String   @default("PROCESSED")

  @@index([receivedAt])
}

