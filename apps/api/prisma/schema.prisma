/// Delivery tracking for the Telegram channel of a notification event.
///
/// One row per (event instance, principal, channel): it records WHAT was
/// attempted, WHEN, and how the provider classified the outcome. It exists so
/// the pipeline can distinguish a transient Telegram outage (retry) from a
/// permanent user/bot relationship failure (stop retrying, mark the account).
///
/// Deliberately never stores secrets (bot token, webhook/callback secret) or
/// raw Telegram API payloads. `telegramAccountId` is a soft reference (no FK):
/// an audit/delivery record must survive account-row lifecycle changes and is
/// removed only by the retention job.
model NotificationDelivery {
  id                String                     @id @default(uuid()) @db.Uuid
  organizationId    String                     @db.Uuid
  /// BullMQ job id of the originating notification event (never a Telegram id).
  eventId           String
  eventType         String
  entityType        String
  entityId          String
  channel           String                     @default("TELEGRAM")
  /// 'USER' | 'PARENT_ACCOUNT' — which principal table owns the delivery.
  principalType     String
  principalId       String                     @db.Uuid
  telegramAccountId String?                    @db.Uuid
  status            NotificationDeliveryStatus @default(PENDING)
  /// Categorized provider failure (NETWORK_ERROR, TIMEOUT, RATE_LIMITED,
  /// TELEGRAM_SERVER_ERROR, BLOCKED_USER, INVALID_CHAT, NOT_CONFIGURED, ...).
  failureCategory   String?
  attempts          Int                        @default(0)
  /// Idempotency key: one delivery record per (event, principal, channel).
  dedupKey          String                     @unique
  /// Rendered content, kept ONLY so a quiet-hours deferral can be re-delivered.
  title             String?
  body              String?
  deferredUntil     DateTime?
  attemptedAt       DateTime                   @default(now())
  sentAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  organization      Organization               @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([telegramAccountId])
  @@index([status, deferredUntil])
  @@index([createdAt])
}

