// M-EDU Prisma schema — reconstructed from compiled API artifacts
// (dist service queries, face adapters, auth service, DTOs).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== Identity & Organization =====================

model Organization {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  email          String
  phone          String?
  timezone       String?  @default("UTC")
  language       String?  @default("en")
  currency       String?  @default("UZS")
  logoUrl        String?
  address        String?
  website        String?
  subscriptionId String?  @db.Uuid
  settings       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users                  User[]
  students               Student[]
  teachers               Teacher[]
  courses                Course[]
  groups                 Group[]
  payments               Payment[]
  expenses               Expense[]
  leads                  Lead[]
  followUps              FollowUp[]
  attendance             Attendance[]
  faceEnrollments        FaceEnrollment[]
  faceTemplates          FaceTemplate[]
  recognitionSessions    RecognitionSession[]
  recognitionAttempts    RecognitionAttempt[]
  faceDevices            FaceDevice[]
  faceDeviceCredentials  FaceDeviceCredential[]
  faceAuditEvents        FaceAuditEvent[]
  cameras                Camera[]
  cameraAttendanceEvents CameraAttendanceEvent[]
  notifications          Notification[]
  grades                 Grade[]
  homework               Homework[]
  sessions               Session[]

  // v2 relationships
  libraryBooks         LibraryBook[]
  employees            Employee[]
  exams                Exam[]
  certificates         Certificate[]
  certificateTemplates CertificateTemplate[]
  inventoryItems       InventoryItem[]
  emailTemplates       EmailTemplate[]
  emailLogs            EmailLog[]
  smsLogs              SMSLog[]
  chatConversations    ChatConversation[]
  parentAccounts       ParentAccount[]
  branding             OrganizationBranding?
  reports              Report[]
  auditLogs            AuditLog[]
  paymentTransactions  PaymentTransaction[]
  subscription         Subscription?
  customRoles          CustomRole[]
  deviceTokens         DeviceToken[]
  LibraryBorrow        LibraryBorrow[]
  SalaryRecord         SalaryRecord[]
  LeaveRequest         LeaveRequest[]
  ExamResult           ExamResult[]
  InventoryTransaction InventoryTransaction[]
  ChatMessage          ChatMessage[]

  @@index([email])
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  email          String    @unique
  passwordHash   String?
  firstName      String
  lastName       String
  phone          String?
  avatar         String?
  role           Role      @default(STUDENT)
  isActive       Boolean   @default(true)
  provider       String?   @default("local")
  googleSubject  String?   @unique
  googleEmail    String?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization           Organization             @relation(fields: [organizationId], references: [id])
  settings               UserSettings?
  sessions               Session[]
  student                Student?
  teacher                Teacher?
  faceAuditEvents        FaceAuditEvent[]
  notifications          Notification[]
  passwordResetTokens    PasswordResetToken[]
  authorizationCodes     AuthorizationCode[]
  userRoles              UserRole[]
  parentStudents         ParentStudent[]
  Employee               Employee?
  ChatParticipant        ChatParticipant[]
  ChatMessage            ChatMessage[]
  DeviceToken            DeviceToken[]
  NotificationPreference NotificationPreference[]
  inventoryTransactions InventoryTransaction[]

  @@index([organizationId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model AuthorizationCode {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique
  accessToken String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.Uuid

  @@index([code])
  @@index([expiresAt])
  @@index([userId])
}

model UserSettings {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @db.Uuid
  theme              String?  @default("light")
  language           String?  @default("en")
  timezone           String?  @default("UTC")
  emailNotifications Boolean? @default(true)
  pushNotifications  Boolean? @default(true)
  smsNotifications   Boolean? @default(false)

  user User @relation(fields: [userId], references: [id])
}

model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  organizationId String    @db.Uuid
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedReason  String?
  createdAt      DateTime  @default(now())

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([expiresAt])
}

// ===================== CRM Domain =====================

model Student {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  userId         String    @unique @db.Uuid
  dateOfBirth    DateTime?
  gender         Gender?
  address        String?
  notes          String?
  parentName     String?
  parentPhone    String?
  parentEmail    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization           Organization            @relation(fields: [organizationId], references: [id])
  user                   User                    @relation(fields: [userId], references: [id])
  groups                 StudentGroup[]
  payments               Payment[]
  attendance             Attendance[]
  grades                 Grade[]
  faceEnrollments        FaceEnrollment[]
  faceTemplates          FaceTemplate[]
  recognitionAttempts    RecognitionAttempt[]
  cameraAttendanceEvents CameraAttendanceEvent[]
  parentStudents         ParentStudent[]
  LibraryBorrow          LibraryBorrow[]
  ExamResult             ExamResult[]
  Certificate            Certificate[]

  @@index([organizationId])
}

model Teacher {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  userId          String   @unique @db.Uuid
  specializations String[]
  hourlyRate      Decimal? @db.Decimal(10, 2)
  bio             String?
  experience      Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  groups       Group[]

  @@index([organizationId])
}

model Course {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  description    String?
  price          Decimal  @db.Decimal(12, 2)
  duration       Int
  level          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  groups       Group[]
  Certificate  Certificate[]

  @@index([organizationId])
}

model Group {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  courseId       String    @db.Uuid
  teacherId      String?   @db.Uuid
  capacity       Int?      @default(20)
  room           String?
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization           Organization            @relation(fields: [organizationId], references: [id])
  course                 Course                  @relation(fields: [courseId], references: [id])
  teacher                Teacher?                @relation(fields: [teacherId], references: [id])
  enrollments            StudentGroup[]
  schedules              Schedule[]
  attendance             Attendance[]
  grades                 Grade[]
  homework               Homework[]
  recognitionSessions    RecognitionSession[]
  cameraAttendanceEvents CameraAttendanceEvent[]
  Exam                   Exam[]

  @@index([organizationId])
  @@index([courseId])
  @@index([teacherId])
}

model StudentGroup {
  organizationId String   @db.Uuid
  studentId      String   @db.Uuid
  groupId        String   @db.Uuid
  isActive       Boolean  @default(true)
  joinedAt       DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([studentId, groupId])
  @@index([groupId])
}

model Schedule {
  id        String    @id @default(uuid()) @db.Uuid
  groupId   String    @db.Uuid
  dayOfWeek DayOfWeek
  startTime String
  endTime   String
  room      String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id])

  @@index([groupId])
}

model Attendance {
  id                   String           @id @default(uuid()) @db.Uuid
  organizationId       String           @db.Uuid
  studentId            String           @db.Uuid
  groupId              String           @db.Uuid
  date                 DateTime
  status               AttendanceStatus @default(PRESENT)
  source               String           @default("MANUAL")
  note                 String?
  confidence           Decimal?         @db.Decimal(6, 4)
  similarityScore      Decimal?         @db.Decimal(6, 4)
  deviceId             String?
  cameraId             String?
  recognitionAttemptId String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  group        Group        @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@unique([studentId, groupId, date])
  @@index([organizationId])
  @@index([organizationId, date])
  @@index([studentId])
  @@index([groupId])
  @@index([date])
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  studentId      String        @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  status         PaymentStatus @default(PENDING)
  description    String?
  dueDate        DateTime?
  method         String?
  reference      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id])
  student      Student              @relation(fields: [studentId], references: [id])
  transactions PaymentTransaction[]

  // One invoice reference per tenant — prevents double-entry of the same
  // payment reference. NULL references are not constrained (Postgres allows
  // multiple NULLs in a unique index), so legacy/unreferenced rows are fine.
  @@unique([organizationId, reference])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([studentId])
}

model Expense {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  category       ExpenseCategory
  amount         Decimal         @db.Decimal(12, 2)
  description    String?
  date           DateTime
  receipt        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([organizationId, date])
}

model Lead {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  firstName      String
  lastName       String?
  phone          String?
  email          String?
  source         String?
  stage          LeadStage @default(NEW)
  lostReason     String?
  notes          String?
  ownerId        String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id])
  activities   LeadActivity[]
  followUps    FollowUp[]

  @@index([organizationId])
  @@index([organizationId, stage])
  @@index([ownerId])
}

model LeadActivity {
  id          String           @id @default(uuid()) @db.Uuid
  leadId      String           @db.Uuid
  type        LeadActivityType
  subject     String
  description String?
  outcome     String?
  createdAt   DateTime         @default(now())

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([leadId])
}

model FollowUp {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  leadId         String   @db.Uuid
  scheduledAt    DateTime
  isCompleted    Boolean  @default(false)
  note           String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  lead         Lead         @relation(fields: [leadId], references: [id])

  @@index([organizationId])
  @@index([leadId])
}

model Notification {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  organizationId String   @db.Uuid
  title          String
  message        String
  type           String   @default("info")
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([organizationId])
}

model Grade {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  studentId      String   @db.Uuid
  groupId        String   @db.Uuid
  value          Float
  maxValue       Float?   @default(100)
  label          String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  group        Group        @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([studentId])
  @@index([groupId])
  @@index([studentId, groupId])
}

model Homework {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  groupId        String    @db.Uuid
  title          String
  description    String?
  deadline       DateTime?
  maxScore       Float?    @default(100)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  group        Group        @relation(fields: [groupId], references: [id])

  @@index([organizationId])
  @@index([groupId])
}

// ===================== Face Recognition =====================

model FaceEnrollment {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  studentId        String           @db.Uuid
  enrolledBy       String?          @db.Uuid
  status           EnrollmentStatus @default(PENDING)
  enrolledAt       DateTime         @default(now())
  activatedAt      DateTime?
  revokedAt        DateTime?
  revokedBy        String?
  revocationReason String?
  metadata         Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  student       Student        @relation(fields: [studentId], references: [id])
  faceTemplates FaceTemplate[]

  @@unique([organizationId, studentId, status])
  @@index([organizationId])
  @@index([studentId])
}

model FaceTemplate {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  enrollmentId   String         @db.Uuid
  studentId      String         @db.Uuid
  templateData   String
  templateHash   String
  version        Int            @default(1)
  status         TemplateStatus @default(ACTIVE)
  modelVersion   String?
  qualityScore   Decimal?       @db.Decimal(6, 4)
  enrolledAt     DateTime       @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id])
  enrollment   FaceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  student      Student        @relation(fields: [studentId], references: [id])

  @@index([organizationId])
  @@index([studentId])
  @@index([enrollmentId])
}

model RecognitionSession {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @db.Uuid
  deviceId       String?
  actorId        String?                  @db.Uuid
  groupId        String?                  @db.Uuid
  lessonId       String?
  status         RecognitionSessionStatus @default(STARTED)
  startedAt      DateTime                 @default(now())
  endedAt        DateTime?
  metadata       Json?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id])
  group        Group?               @relation(fields: [groupId], references: [id])
  attempts     RecognitionAttempt[]

  @@index([organizationId])
  @@index([groupId])
}

model RecognitionAttempt {
  id                  String                   @id @default(uuid()) @db.Uuid
  organizationId      String                   @db.Uuid
  sessionId           String                   @db.Uuid
  identifiedStudentId String?                  @db.Uuid
  actorId             String?                  @db.Uuid
  status              RecognitionAttemptStatus
  confidence          Decimal?                 @db.Decimal(6, 4)
  qualityScore        Decimal?                 @db.Decimal(6, 4)
  livenessResult      String?
  similarityScore     Decimal?                 @db.Decimal(6, 4)
  processingTimeMs    Int?
  metadata            Json?
  occurredAt          DateTime                 @default(now())
  createdAt           DateTime                 @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id])
  session      RecognitionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student      Student?           @relation(fields: [identifiedStudentId], references: [id])

  @@index([organizationId])
  @@index([sessionId])
  @@index([identifiedStudentId])
}

model FaceDevice {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  status         DeviceStatus @default(REGISTERED)
  lastSeenAt     DateTime?
  registeredAt   DateTime     @default(now())
  revokedAt      DateTime?
  revokedBy      String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id])
  credentials  FaceDeviceCredential[]

  @@index([organizationId])
}

model FaceDeviceCredential {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  faceDeviceId   String   @db.Uuid
  apiKeyHash     String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  device       FaceDevice   @relation(fields: [faceDeviceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([faceDeviceId])
}

model FaceAuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String?  @db.Uuid
  type           String
  resourceType   String
  resourceId     String?
  description    String
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([createdAt])
  @@index([userId])
}

// ===================== Camera Management =====================

model Camera {
  id                   String         @id @default(uuid()) @db.Uuid
  organizationId       String         @db.Uuid
  name                 String
  vendor               String?
  model                String?
  protocol             CameraProtocol @default(RTSP)
  host                 String
  port                 Int            @default(554)
  streamPath           String?
  rtspTransport        String         @default("tcp")
  encryptedCredentials String?
  credentialConfigured Boolean        @default(false)
  processingFps        Float          @default(3.0)
  location             String?
  enabled              Boolean        @default(true)
  recognitionEnabled   Boolean        @default(true)
  attendanceEnabled    Boolean        @default(true)
  status               String         @default("CONFIGURED")
  lastSeenAt           DateTime?
  lastErrorAt          DateTime?
  lastErrorCode        String?
  lastErrorMessage     String?
  reconnectCount       Int            @default(0)
  metadata             Json?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  organization     Organization            @relation(fields: [organizationId], references: [id])
  schedules        CameraSchedule[]
  zones            CameraZone[]
  attendanceEvents CameraAttendanceEvent[]

  @@index([organizationId])
}

model CameraSchedule {
  id                 String    @id @default(uuid()) @db.Uuid
  cameraId           String    @db.Uuid
  name               String?
  dayOfWeek          DayOfWeek
  startTime          String
  endTime            String
  isActive           Boolean   @default(true)
  processingFps      Float?
  recognitionEnabled Boolean?
  attendanceEnabled  Boolean?

  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([cameraId])
}

model CameraZone {
  id       String  @id @default(uuid()) @db.Uuid
  cameraId String  @db.Uuid
  name     String?
  type     String  @default("custom")
  x        Int?
  y        Int?
  width    Int?
  height   Int?
  isActive Boolean @default(true)

  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([cameraId])
}

model CameraAttendanceEvent {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  cameraId        String   @db.Uuid
  studentId       String   @db.Uuid
  groupId         String?  @db.Uuid
  recognizedAt    DateTime
  date            DateTime
  confidence      Decimal? @db.Decimal(6, 4)
  similarityScore Decimal? @db.Decimal(6, 4)
  faceQuality     Decimal? @db.Decimal(6, 4)
  decision        String
  attendanceId    String?
  idempotencyKey  String
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  camera       Camera       @relation(fields: [cameraId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])
  group        Group?       @relation(fields: [groupId], references: [id])

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([cameraId])
  @@index([studentId])
  @@index([groupId])
}

// ===================== Enums =====================

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  MANAGER
  TEACHER
  ASSISTANT
  STUDENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
  CANCELLED
}

enum ExpenseCategory {
  SALARY
  RENT
  UTILITIES
  MARKETING
  SUPPLIES
  MAINTENANCE
  SOFTWARE
  TRAINING
  OTHER
}

enum LeadStage {
  NEW
  CONTACTED
  TRIAL_LESSON
  WON
  LOST
}

enum LeadActivityType {
  CALL
  MESSAGE
  MEETING
  REMINDER
  TASK
  NOTE
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  REVOKED
  EXPIRED
}

enum TemplateStatus {
  ACTIVE
  REVOKED
  EXPIRED
  CORRUPTED
}

enum RecognitionSessionStatus {
  STARTED
  IN_PROGRESS
  FINISHED
  CANCELLED
  ERROR
}

enum RecognitionAttemptStatus {
  DETECTED
  QUALITY_PASSED
  QUALITY_FAILED
  LIVENESS_PASSED
  LIVENESS_FAILED
  LIVENESS_UNCERTAIN
  LIVENESS_UNAVAILABLE
  EMBEDDING_GENERATED
  MATCH_FOUND
  MATCH_NOT_FOUND
  MATCH_UNCERTAIN
  IDENTIFIED
  UNIDENTIFIED
  ERROR
}

enum DeviceStatus {
  REGISTERED
  ACTIVE
  REVOKED
  SUSPENDED
}

enum CameraProtocol {
  RTSP
  ONVIF
}

// ===================== v2 Enums =====================

enum BorrowStatus {
  ACTIVE
  RETURNED
  OVERDUE
  LOST
}

enum ContractType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum ExamType {
  MIDTERM
  FINAL
  QUIZ
  ASSIGNMENT
}

enum InventoryCategory {
  BOOKS
  EQUIPMENT
  FURNITURE
  SUPPLIES
  ELECTRONICS
}

enum AssetStatus {
  ACTIVE
  MAINTENANCE
  DAMAGED
  DISPOSED
}

enum TransactionType {
  PURCHASE
  ISSUE
  RETURN
  DAMAGE
  DISPOSAL
}

enum EmailCategory {
  ATTENDANCE
  PAYMENT
  GRADES
  HOMEWORK
  GENERAL
}

enum SMSStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum ReportType {
  ATTENDANCE
  FINANCIAL
  ACADEMIC
  CUSTOM
}

enum PaymentGateway {
  PAYME
  CLICK
  UZUM
  STRIPE
  PAYPAL
  CASH
  BANK
}

enum SubscriptionPlan {
  FREE
  BASIC
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  EXPIRED
  CANCELLED
}

enum LeaveType {
  SICK
  VACATION
  PERSONAL
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ===================== v2 Models =====================

model LibraryBook {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  title          String
  author         String?
  isbn           String?
  barcode        String   @unique
  category       String
  quantity       Int      @default(1)
  available      Int      @default(1)
  location       String?
  publisher      String?
  publishedYear  Int?
  language       String?  @default("en")
  description    String?
  coverImage     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization    @relation(fields: [organizationId], references: [id])
  borrowRecords LibraryBorrow[]

  @@index([organizationId])
  @@index([category])
  @@index([isbn])
}

model LibraryBorrow {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  bookId         String       @db.Uuid
  studentId      String       @db.Uuid
  borrowedAt     DateTime     @default(now())
  dueDate        DateTime
  returnedAt     DateTime?
  lateFee        Decimal?     @db.Decimal(10, 2)
  status         BorrowStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  book         LibraryBook  @relation(fields: [bookId], references: [id], onDelete: Restrict)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([bookId])
  @@index([studentId])
  @@index([status])
  @@index([dueDate])
}

model Employee {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  userId          String       @unique @db.Uuid
  employeeNumber  String       @unique
  department      String
  position        String
  hireDate        DateTime
  terminationDate DateTime?
  salary          Decimal      @db.Decimal(12, 2)
  contractType    ContractType
  bankAccount     String?
  taxId           String?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  salaryRecords SalaryRecord[]
  leaveRequests LeaveRequest[]

  @@index([organizationId])
  @@index([department])
}

model SalaryRecord {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  employeeId     String        @db.Uuid
  month          DateTime
  baseSalary     Decimal       @db.Decimal(12, 2)
  bonuses        Decimal?      @db.Decimal(10, 2)
  deductions     Decimal?      @db.Decimal(10, 2)
  tax            Decimal?      @db.Decimal(10, 2)
  netSalary      Decimal       @db.Decimal(12, 2)
  paymentDate    DateTime?
  status         PaymentStatus @default(PENDING)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, month])
  @@index([organizationId])
  @@index([status])
}

model LeaveRequest {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @db.Uuid
  employeeId      String      @db.Uuid
  type            LeaveType
  startDate       DateTime
  endDate         DateTime
  reason          String?
  status          LeaveStatus @default(PENDING)
  approvedBy      String?     @db.Uuid
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@index([organizationId])
  @@index([employeeId])
  @@index([status])
  @@index([startDate])
}

model Exam {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  groupId        String   @db.Uuid
  subject        String
  title          String
  description    String?
  examDate       DateTime
  duration       Int
  totalMarks     Decimal  @db.Decimal(6, 2)
  passingMarks   Decimal  @db.Decimal(6, 2)
  examType       ExamType
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  group        Group        @relation(fields: [groupId], references: [id])
  results      ExamResult[]

  @@index([organizationId])
  @@index([groupId])
  @@index([examDate])
}

model ExamResult {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  examId         String    @db.Uuid
  studentId      String    @db.Uuid
  marksObtained  Decimal   @db.Decimal(6, 2)
  grade          String?
  rank           Int?
  isPassed       Boolean   @default(false)
  submittedAt    DateTime?
  evaluatedAt    DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  exam         Exam         @relation(fields: [examId], references: [id], onDelete: Restrict)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([examId, studentId])
  @@index([organizationId])
  @@index([studentId])
}

model Certificate {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @db.Uuid
  studentId         String   @db.Uuid
  courseId          String   @db.Uuid
  certificateNumber String   @unique
  issueDate         DateTime @default(now())
  templateId        String?  @db.Uuid
  pdfUrl            String?
  verificationCode  String   @unique
  isActive          Boolean  @default(true)
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([studentId])
}

model CertificateTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  htmlTemplate   String
  cssStyles      String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model InventoryItem {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  name           String
  category       InventoryCategory
  quantity       Int               @default(0)
  unit           String
  minStock       Int               @default(0)
  purchasePrice  Decimal?          @db.Decimal(12, 2)
  sellingPrice   Decimal?          @db.Decimal(12, 2)
  location       String?
  supplier       String?
  purchaseDate   DateTime?
  warrantyExpiry DateTime?
  status         AssetStatus       @default(ACTIVE)
  description    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id])
  transactions InventoryTransaction[]

  @@index([organizationId])
  @@index([category])
  @@index([status])
  @@index([quantity])
}

model InventoryTransaction {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  itemId         String          @db.Uuid
  type           TransactionType
  quantity       Int
  notes          String?
  createdBy      String?         @db.Uuid
  createdAt      DateTime        @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id])
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  creator      User?         @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([itemId])
  @@index([type])
  @@index([createdAt])
}

model EmailTemplate {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  name           String
  subject        String
  htmlBody       String
  textBody       String?
  variables      String[]
  category       EmailCategory
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([category])
}

model EmailLog {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  recipient      String
  subject        String
  templateId     String?   @db.Uuid
  status         String
  sentAt         DateTime?
  errorMessage   String?
  metadata       Json?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
}

model SMSLog {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  recipient      String
  message        String
  status         SMSStatus @default(PENDING)
  provider       String
  externalId     String?
  sentAt         DateTime?
  deliveredAt    DateTime?
  errorMessage   String?
  cost           Decimal?  @db.Decimal(10, 4)
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([status])
  @@index([provider])
}

model ChatConversation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  type           String    @default("DIRECT")
  title          String?
  createdBy      String    @db.Uuid
  lastMessageAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  participants ChatParticipant[]
  messages     ChatMessage[]

  @@index([organizationId])
  @@index([lastMessageAt])
}

model ChatParticipant {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @db.Uuid
  userId         String    @db.Uuid
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation ChatConversation @relation(fields: [conversationId], references: [id])
  user         User             @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([userId])
}

model ChatMessage {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  conversationId String    @db.Uuid
  senderId       String    @db.Uuid
  message        String
  attachmentUrl  String?
  isRead         Boolean   @default(false)
  readAt         DateTime?
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id])
  conversation ChatConversation @relation(fields: [conversationId], references: [id])
  sender       User             @relation(fields: [senderId], references: [id])

  @@index([organizationId])
  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@index([isRead])
}

model ParentAccount {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  email          String
  phone          String?
  firstName      String
  lastName       String
  passwordHash   String
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  students     ParentStudent[]

  @@unique([organizationId, email])
  @@index([organizationId])
}

model ParentStudent {
  id                String   @id @default(uuid()) @db.Uuid
  parentId          String   @db.Uuid
  studentId         String   @db.Uuid
  relationship      String   @default("parent")
  isPrimary         Boolean  @default(false)
  canViewGrades     Boolean  @default(true)
  canViewPayments   Boolean  @default(true)
  canViewAttendance Boolean  @default(true)
  createdAt         DateTime @default(now())

  parent  ParentAccount @relation(fields: [parentId], references: [id])
  student Student       @relation(fields: [studentId], references: [id])
  User    User?         @relation(fields: [userId], references: [id])
  userId  String?       @db.Uuid

  @@unique([parentId, studentId])
  @@index([studentId])
}

model OrganizationBranding {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @unique @db.Uuid
  logoUrl         String?
  faviconUrl      String?
  primaryColor    String?
  secondaryColor  String?
  accentColor     String?
  backgroundColor String?
  textColor       String?
  customDomain    String?  @unique
  emailSignature  String?
  faviconEmoji    String?
  supportEmail    String?
  supportPhone    String?
  socialLinks     Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}

model Report {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  name           String
  type           ReportType
  parameters     Json
  schedule       String?
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  isActive       Boolean    @default(true)
  createdBy      String     @db.Uuid
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([type])
  @@index([nextRunAt])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String?  @db.Uuid
  action         String
  resource       String
  resourceId     String?
  changes        Json?
  ipAddress      String?
  userAgent      String?
  method         String?
  path           String?
  statusCode     Int?
  timestamp      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([resource, resourceId])
  @@index([timestamp])
  @@index([action])
}

model PaymentTransaction {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @db.Uuid
  paymentId       String?        @db.Uuid
  gateway         PaymentGateway
  externalId      String?
  amount          Decimal        @db.Decimal(12, 2)
  currency        String         @default("UZS")
  status          String
  requestPayload  Json?
  responsePayload Json?
  errorMessage    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  payment      Payment?     @relation(fields: [paymentId], references: [id])

  @@index([organizationId])
  @@index([gateway])
  @@index([externalId])
  @@index([status])
  @@index([createdAt])
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @unique @db.Uuid
  plan               SubscriptionPlan
  status             SubscriptionStatus
  trialStartAt       DateTime?
  trialEndAt         DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelledAt        DateTime?
  features           Json?
  maxStudents        Int?
  maxTeachers        Int?
  maxCameras         Int?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([status])
  @@index([currentPeriodEnd])
}

model CustomRole {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  description    String?
  permissions    String[]
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  users        UserRole[]

  @@unique([organizationId, name])
}

model UserRole {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())
  assignedBy String?  @db.Uuid

  user User       @relation(fields: [userId], references: [id])
  role CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
}

model DeviceToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  token      String
  platform   String
  deviceId   String?
  appVersion String?
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user           User          @relation(fields: [userId], references: [id])
  Organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?       @db.Uuid

  @@unique([userId, token])
  @@index([userId])
  @@index([token])
}

model NotificationPreference {
  id           String  @id @default(uuid()) @db.Uuid
  userId       String  @db.Uuid
  category     String
  emailEnabled Boolean @default(true)
  smsEnabled   Boolean @default(false)
  pushEnabled  Boolean @default(true)
  inAppEnabled Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

// ===================== Platform Expansion Models =====================
// Audit Timeline: already exists (AuditLog model at line 1440).
// We extend with a Document model and related structures for the
// platform expansion (Legal / Documents, Resources, Feature Flags, etc.)

model Document {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  title           String
  description     String?
  category        String   @default("OTHER")
  fileUrl         String
  fileSize        Int
  mimeType        String
  version         Int      @default(1)
  tags            String[]
  relatedEntityType String?
  relatedEntityId String?
  uploadedBy      String
  uploadedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt
  expiresAt       DateTime?

  versions        DocumentVersion[]

  @@index([organizationId])
  @@index([category])
  @@index([relatedEntityType, relatedEntityId])
  @@index([tags])
  @@index([title])
  @@index([updatedAt])
}

model DocumentVersion {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @db.Uuid
  version    Int
  fileUrl    String
  fileSize   Int
  mimeType   String
  uploadedBy String
  uploadedAt DateTime @default(now())
  note       String?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([version])
  @@unique([documentId, version])
}

model Resource {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  type           String   @default("ROOM")
  capacity       Int?
  location       String?
  description    String?
  isActive       Boolean  @default(true)
  availability   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bookings       ResourceBooking[]

  @@index([organizationId])
  @@index([type])
  @@index([isActive])
}

model ResourceBooking {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  resourceId     String   @db.Uuid
  title          String
  description    String?
  startAt        DateTime
  endAt          DateTime
  status         String   @default("PENDING")
  bookedBy       String
  attendees      Int?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([resourceId, startAt])
  @@index([status])
}

model FeatureFlag {
  id                  String   @id @default(uuid()) @db.Uuid
  key                 String   @unique
  name                String
  description         String?
  type                String   @default("BOOLEAN")
  enabled             Boolean  @default(false)
  value               Json?
  rolloutOrganizations String[]
  rolloutPercentage   Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([key])
  @@index([enabled])
}

model WorkflowRule {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  name            String
  description     String?
  enabled         Boolean  @default(true)
  trigger         String
  entityType      String
  conditions      Json?
  steps           Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastRunAt       DateTime?
  lastRunStatus   String?
  runCount        Int     @default(0)

  @@index([organizationId])
  @@index([entityType])
  @@index([enabled, trigger])
}

model WorkflowInstance {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  ruleId          String   @db.Uuid
  status          String   @default("PENDING")
  triggerPayload  Json?
  steps           Json
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  error           String?

  @@index([organizationId, status])
  @@index([ruleId])
}

model DataQualityIssue {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  entityType     String
  entityId       String
  category       String   @default("OTHER")
  severity       String   @default("MEDIUM")
  field          String?
  message        String
  ruleId         String
  detectedAt     DateTime @default(now())
  resolvedAt     DateTime?
  resolvedBy     String?
  resolutionNote String?

  @@index([organizationId, severity])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, resolvedAt])
  @@index([ruleId])
}
