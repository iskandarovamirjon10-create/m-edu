generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [pg_trgm]
}

model Organization {
  branches               Branch[]
  holidays               OrganizationHoliday[]
  id                     String                  @id @default(uuid()) @db.Uuid
  name                   String
  email                  String
  phone                  String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  timezone               String?                 @default("UTC")
  language               String?                 @default("en")
  currency               String?                 @default("UZS")
  logoUrl                String?
  address                String?
  website                String?
  subscriptionId         String?                 @db.Uuid
  settings               Json?
  attendance             Attendance[]
  auditLogs              AuditLog[]
  cameras                Camera[]
  cameraAttendanceEvents CameraAttendanceEvent[]
  certificates           Certificate[]
  certificateTemplates   CertificateTemplate[]
  chatConversations      ChatConversation[]
  ChatMessage            ChatMessage[]
  courses                Course[]
  customRoles            CustomRole[]
  deviceTokens           DeviceToken[]
  Discount               Discount[]
  emailLogs              EmailLog[]
  emailTemplates         EmailTemplate[]
  employees              Employee[]
  exams                  Exam[]
  ExamResult             ExamResult[]
  expenses               Expense[]
  faceAuditEvents        FaceAuditEvent[]
  faceDevices            FaceDevice[]
  faceDeviceCredentials  FaceDeviceCredential[]
  faceEnrollments        FaceEnrollment[]
  faceTemplates          FaceTemplate[]
  followUps              FollowUp[]
  grades                 Grade[]
  groups                 Group[]
  homework               Homework[]
  inventoryItems         InventoryItem[]
  InventoryTransaction   InventoryTransaction[]
  Invoice                Invoice[]
  leads                  Lead[]
  LeaveRequest           LeaveRequest[]
  Lesson                 Lesson[]
  libraryBooks           LibraryBook[]
  LibraryBorrow          LibraryBorrow[]
  notifications          Notification[]
  branding               OrganizationBranding?
  parentAccounts         ParentAccount[]
  payments               Payment[]
  paymentTransactions    PaymentTransaction[]
  PayrollRun             PayrollRun[]
  recognitionAttempts    RecognitionAttempt[]
  recognitionSessions    RecognitionSession[]
  refunds                Refund[]
  reports                Report[]
  smsLogs                SMSLog[]
  SalaryRecord           SalaryRecord[]
  sessions               Session[]
  students               Student[]
  subscription           Subscription?
  teachers               Teacher[]
  users                  User[]
  DataExportLog          DataExportLog[]
  ApiKey                 ApiKey[]
  StudentGamification    StudentGamification[]
  ParentSession          ParentSession[]
  HomeworkSubmission     HomeworkSubmission[]
}

model User {
  id                     String                   @id @default(uuid()) @db.Uuid
  organizationId         String                   @db.Uuid
  email                  String                   @unique
  passwordHash           String?
  firstName              String
  lastName               String
  phone                  String?
  avatar                 String?
  role                   Role                     @default(STUDENT)
  isActive               Boolean                  @default(true)
  provider               String?                  @default("local")
  googleSubject          String?                  @unique
  googleEmail            String?
  lastLoginAt            DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  telegramChatId         String?                  @unique
  telegramLinkToken      String?                  @unique
  telegramLinkExpiresAt  DateTime?
  authorizationCodes     AuthorizationCode[]
  ChatMessage            ChatMessage[]
  ChatParticipant        ChatParticipant[]
  DeviceToken            DeviceToken[]
  Employee               Employee?
  faceAuditEvents        FaceAuditEvent[]
  inventoryTransactions  InventoryTransaction[]
  notifications          Notification[]
  NotificationPreference NotificationPreference[]
  parentStudents         ParentStudent[]
  passwordResetTokens    PasswordResetToken[]
  sessions               Session[]
  student                Student?
  teacher                Teacher?
  organization           Organization             @relation(fields: [organizationId], references: [id])
  userRoles              UserRole[]
  settings               UserSettings?
  DataExportLog          DataExportLog[]
  Branch                 Branch[]
  automationRulesCreated AutomationRule[]
  financialPeriodsClosed FinancialPeriod[]
  apiKeysCreated         ApiKey[]

  @@index([organizationId])
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "user_email_trgm_idx")
  @@index([firstName(ops: raw("gin_trgm_ops"))], type: Gin, map: "user_first_name_trgm_idx")
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin, map: "user_last_name_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "user_phone_trgm_idx")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model AuthorizationCode {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique
  accessToken String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([expiresAt])
  @@index([userId])
}

model UserSettings {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @db.Uuid
  theme              String?  @default("light")
  language           String?  @default("en")
  timezone           String?  @default("UTC")
  emailNotifications Boolean? @default(true)
  pushNotifications  Boolean? @default(true)
  smsNotifications   Boolean? @default(false)
  user               User     @relation(fields: [userId], references: [id])
}

model Session {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  organizationId String       @db.Uuid
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedReason  String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([expiresAt])
}

model Student {
  homeworkSubmissions    HomeworkSubmission[]
  branchId               String?                 @db.Uuid
  branch                 Branch?                 @relation(fields: [branchId], references: [id])
  id                     String                  @id @default(uuid()) @db.Uuid
  organizationId         String                  @db.Uuid
  userId                 String                  @unique @db.Uuid
  dateOfBirth            DateTime?
  gender                 Gender?
  address                String?
  notes                  String?
  parentName             String?
  parentPhone            String?
  parentEmail            String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  status                 StudentStatus           @default(ACTIVE)
  discount               Decimal?                @db.Decimal(5, 2)
  emergencyContact       String?
  enrollmentDate         DateTime?
  nationality            String?
  balance                Decimal                 @default(0) @db.Decimal(12, 2)
  attendance             Attendance[]
  cameraAttendanceEvents CameraAttendanceEvent[]
  Certificate            Certificate[]
  Discount               Discount[]
  ExamResult             ExamResult[]
  faceEnrollments        FaceEnrollment[]
  faceTemplates          FaceTemplate[]
  grades                 Grade[]
  Invoice                Invoice[]
  LibraryBorrow          LibraryBorrow[]
  parentStudents         ParentStudent[]
  payments               Payment[]
  recognitionAttempts    RecognitionAttempt[]
  organization           Organization            @relation(fields: [organizationId], references: [id])
  user                   User                    @relation(fields: [userId], references: [id])
  groups                 StudentGroup[]
  StudentGamification    StudentGamification?
  xpEvents               GamificationXpEvent[]

  @@index([organizationId])
  @@index([organizationId, status])
}

model Teacher {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  userId          String       @unique @db.Uuid
  specializations String[]
  hourlyRate      Decimal?     @db.Decimal(10, 2)
  bio             String?
  experience      Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  lessonRate      Decimal?     @db.Decimal(10, 2)
  salaryType      SalaryType   @default(MONTHLY)
  employeeId      String?      @unique @db.Uuid
  groups          Group[]
  Lesson          Lesson[]
  PayrollRun      PayrollRun[]
  Employee        Employee?    @relation(fields: [employeeId], references: [id])
  organization    Organization @relation(fields: [organizationId], references: [id])
  user            User         @relation(fields: [userId], references: [id])

  @@index([organizationId])
}

model Course {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  name           String
  description    String?
  price          Decimal       @db.Decimal(12, 2)
  duration       Int
  level          String?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  Certificate    Certificate[]
  organization   Organization  @relation(fields: [organizationId], references: [id])
  Discount       Discount[]
  groups         Group[]

  @@index([organizationId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "course_name_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "course_description_trgm_idx")
}

model Group {
  id                     String                  @id @default(uuid()) @db.Uuid
  organizationId         String                  @db.Uuid
  name                   String
  courseId               String                  @db.Uuid
  teacherId              String?                 @db.Uuid
  capacity               Int?                    @default(20)
  room                   String?
  startDate              DateTime?
  endDate                DateTime?
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  attendance             Attendance[]
  cameraAttendanceEvents CameraAttendanceEvent[]
  Discount               Discount[]
  Exam                   Exam[]
  grades                 Grade[]
  course                 Course                  @relation(fields: [courseId], references: [id])
  organization           Organization            @relation(fields: [organizationId], references: [id])
  teacher                Teacher?                @relation(fields: [teacherId], references: [id])
  homework               Homework[]
  Lesson                 Lesson[]
  recognitionSessions    RecognitionSession[]
  schedules              Schedule[]
  enrollments            StudentGroup[]
  Branch                 Branch?                 @relation(fields: [branchId], references: [id])
  branchId               String?                 @db.Uuid

  @@index([organizationId])
  @@index([courseId])
  @@index([teacherId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "group_name_trgm_idx")
}

model StudentGroup {
  organizationId String   @db.Uuid
  studentId      String   @db.Uuid
  groupId        String   @db.Uuid
  isActive       Boolean  @default(true)
  joinedAt       DateTime @default(now())
  leftAt         DateTime?
  group          Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([studentId, groupId])
  @@index([groupId])
}

model Schedule {
  id        String    @id @default(uuid()) @db.Uuid
  groupId   String    @db.Uuid
  dayOfWeek DayOfWeek
  startTime String
  endTime   String
  room      String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  Lesson    Lesson[]
  group     Group     @relation(fields: [groupId], references: [id])

  @@index([groupId])
}

model Attendance {
  id                   String           @id @default(uuid()) @db.Uuid
  organizationId       String           @db.Uuid
  studentId            String           @db.Uuid
  groupId              String           @db.Uuid
  date                 DateTime
  status               AttendanceStatus @default(PRESENT)
  source               String           @default("MANUAL")
  note                 String?
  confidence           Decimal?         @db.Decimal(6, 4)
  similarityScore      Decimal?         @db.Decimal(6, 4)
  deviceId             String?
  cameraId             String?
  recognitionAttemptId String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  lessonId             String?          @db.Uuid
  group                Group            @relation(fields: [groupId], references: [id])
  lesson               Lesson?          @relation(fields: [lessonId], references: [id])
  organization         Organization     @relation(fields: [organizationId], references: [id])
  student              Student          @relation(fields: [studentId], references: [id])

  @@unique([studentId, groupId, date])
  @@index([organizationId])
  @@index([organizationId, date])
  @@index([studentId])
  @@index([groupId])
  @@index([date])
  @@index([lessonId])
}

model Payment {
  id              String               @id @default(uuid()) @db.Uuid
  organizationId  String               @db.Uuid
  studentId       String               @db.Uuid
  amount          Decimal              @db.Decimal(12, 2)
  status          PaymentStatus        @default(PENDING)
  description     String?
  dueDate         DateTime?
  method          String?
  reference       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  invoiceId       String?              @db.Uuid
  receiptNumber   String?
  receiptIssuedAt DateTime?
  paidAt          DateTime?
  Invoice         Invoice?             @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  organization    Organization         @relation(fields: [organizationId], references: [id])
  student         Student              @relation(fields: [studentId], references: [id])
  transactions    PaymentTransaction[]
  refunds         Refund[]

  @@unique([organizationId, reference])
  @@unique([organizationId, receiptNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([studentId])
  @@index([invoiceId])
  @@index([reference])
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "payment_description_trgm_idx")
  @@index([reference(ops: raw("gin_trgm_ops"))], type: Gin, map: "payment_reference_trgm_idx")
}

model Expense {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  category       ExpenseCategory
  amount         Decimal         @db.Decimal(12, 2)
  description    String?
  date           DateTime
  receipt        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([organizationId, date])
}

model Lead {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  firstName      String
  lastName       String?
  phone          String?
  email          String?
  source         String?
  stage          LeadStage      @default(NEW)
  lostReason     String?
  notes          String?
  ownerId        String?        @db.Uuid
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  followUps      FollowUp[]
  organization   Organization   @relation(fields: [organizationId], references: [id])
  activities     LeadActivity[]

  @@index([organizationId])
  @@index([organizationId, stage])
  @@index([ownerId])
  @@index([firstName(ops: raw("gin_trgm_ops"))], type: Gin, map: "lead_first_name_trgm_idx")
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin, map: "lead_last_name_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "lead_email_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "lead_phone_trgm_idx")
}

model LeadActivity {
  id          String           @id @default(uuid()) @db.Uuid
  leadId      String           @db.Uuid
  type        LeadActivityType
  subject     String
  description String?
  outcome     String?
  createdAt   DateTime         @default(now())
  lead        Lead             @relation(fields: [leadId], references: [id])

  @@index([leadId])
}

model FollowUp {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  leadId         String       @db.Uuid
  scheduledAt    DateTime
  isCompleted    Boolean      @default(false)
  note           String?
  createdAt      DateTime     @default(now())
  lead           Lead         @relation(fields: [leadId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([leadId])
}

model Notification {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  organizationId String       @db.Uuid
  title          String
  message        String
  type           String       @default("info")
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([organizationId])
}

model Grade {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  studentId      String       @db.Uuid
  groupId        String       @db.Uuid
  value          Float
  maxValue       Float?       @default(100)
  label          String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  group          Group        @relation(fields: [groupId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  student        Student      @relation(fields: [studentId], references: [id])

  @@index([organizationId])
  @@index([studentId])
  @@index([groupId])
  @@index([studentId, groupId])
}

model Homework {
  submissions    HomeworkSubmission[]
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  groupId        String               @db.Uuid
  title          String
  description    String?
  deadline       DateTime?
  maxScore       Float?               @default(100)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  group          Group                @relation(fields: [groupId], references: [id])
  organization   Organization         @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([groupId])
}

model FaceEnrollment {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  studentId        String           @db.Uuid
  enrolledBy       String?          @db.Uuid
  status           EnrollmentStatus @default(PENDING)
  enrolledAt       DateTime         @default(now())
  activatedAt      DateTime?
  revokedAt        DateTime?
  revokedBy        String?
  revocationReason String?
  metadata         Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  organization     Organization     @relation(fields: [organizationId], references: [id])
  student          Student          @relation(fields: [studentId], references: [id])
  faceTemplates    FaceTemplate[]

  @@index([organizationId])
  @@index([studentId])
}

model FaceTemplate {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  enrollmentId   String         @db.Uuid
  studentId      String         @db.Uuid
  templateData   String
  templateHash   String
  version        Int            @default(1)
  status         TemplateStatus @default(ACTIVE)
  modelVersion   String?
  qualityScore   Decimal?       @db.Decimal(6, 4)
  enrolledAt     DateTime       @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  enrollment     FaceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id])
  student        Student        @relation(fields: [studentId], references: [id])

  @@index([organizationId])
  @@index([studentId])
  @@index([enrollmentId])
}

model RecognitionSession {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @db.Uuid
  deviceId       String?
  actorId        String?                  @db.Uuid
  groupId        String?                  @db.Uuid
  lessonId       String?
  status         RecognitionSessionStatus @default(STARTED)
  startedAt      DateTime                 @default(now())
  endedAt        DateTime?
  metadata       Json?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  attempts       RecognitionAttempt[]
  group          Group?                   @relation(fields: [groupId], references: [id])
  organization   Organization             @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([groupId])
}

model RecognitionAttempt {
  id                  String                   @id @default(uuid()) @db.Uuid
  organizationId      String                   @db.Uuid
  sessionId           String                   @db.Uuid
  identifiedStudentId String?                  @db.Uuid
  actorId             String?                  @db.Uuid
  status              RecognitionAttemptStatus
  confidence          Decimal?                 @db.Decimal(6, 4)
  qualityScore        Decimal?                 @db.Decimal(6, 4)
  livenessResult      String?
  similarityScore     Decimal?                 @db.Decimal(6, 4)
  processingTimeMs    Int?
  metadata            Json?
  occurredAt          DateTime                 @default(now())
  createdAt           DateTime                 @default(now())
  student             Student?                 @relation(fields: [identifiedStudentId], references: [id])
  organization        Organization             @relation(fields: [organizationId], references: [id])
  session             RecognitionSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([sessionId])
  @@index([identifiedStudentId])
}

model FaceDevice {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @db.Uuid
  name           String
  status         DeviceStatus           @default(REGISTERED)
  lastSeenAt     DateTime?
  registeredAt   DateTime               @default(now())
  revokedAt      DateTime?
  revokedBy      String?
  metadata       Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  organization   Organization           @relation(fields: [organizationId], references: [id])
  credentials    FaceDeviceCredential[]

  @@index([organizationId])
}

model FaceDeviceCredential {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  faceDeviceId   String       @db.Uuid
  apiKeyHash     String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  device         FaceDevice   @relation(fields: [faceDeviceId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([faceDeviceId])
}

model FaceAuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String?      @db.Uuid
  type           String
  resourceType   String
  resourceId     String?
  description    String
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([createdAt])
  @@index([userId])
}

model Camera {
  id                   String                  @id @default(uuid()) @db.Uuid
  organizationId       String                  @db.Uuid
  name                 String
  vendor               String?
  model                String?
  protocol             CameraProtocol          @default(RTSP)
  host                 String
  port                 Int                     @default(554)
  streamPath           String?
  rtspTransport        String                  @default("tcp")
  encryptedCredentials String?
  credentialConfigured Boolean                 @default(false)
  processingFps        Float                   @default(3.0)
  location             String?
  enabled              Boolean                 @default(true)
  recognitionEnabled   Boolean                 @default(true)
  attendanceEnabled    Boolean                 @default(true)
  status               String                  @default("CONFIGURED")
  lastSeenAt           DateTime?
  lastErrorAt          DateTime?
  lastErrorCode        String?
  lastErrorMessage     String?
  reconnectCount       Int                     @default(0)
  metadata             Json?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  organization         Organization            @relation(fields: [organizationId], references: [id])
  attendanceEvents     CameraAttendanceEvent[]
  schedules            CameraSchedule[]
  zones                CameraZone[]

  @@index([organizationId])
}

model CameraSchedule {
  id                 String    @id @default(uuid()) @db.Uuid
  cameraId           String    @db.Uuid
  name               String?
  dayOfWeek          DayOfWeek
  startTime          String
  endTime            String
  isActive           Boolean   @default(true)
  processingFps      Float?
  recognitionEnabled Boolean?
  attendanceEnabled  Boolean?
  camera             Camera    @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([cameraId])
}

model CameraZone {
  id       String  @id @default(uuid()) @db.Uuid
  cameraId String  @db.Uuid
  name     String?
  type     String  @default("custom")
  x        Int?
  y        Int?
  width    Int?
  height   Int?
  isActive Boolean @default(true)
  camera   Camera  @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([cameraId])
}

model CameraAttendanceEvent {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  cameraId        String       @db.Uuid
  studentId       String       @db.Uuid
  groupId         String?      @db.Uuid
  recognizedAt    DateTime
  date            DateTime
  confidence      Decimal?     @db.Decimal(6, 4)
