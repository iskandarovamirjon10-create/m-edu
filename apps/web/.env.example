# Frontend build-time variables (Vite). Only VITE_-prefixed variables are
# shipped to the browser bundle.

# Backend base URL. Use a full absolute URL in production, e.g.
#   VITE_API_URL=https://api.m-edu.io/api
# or /api when the API is reverse-proxied behind the same origin.
VITE_API_URL=/api

# Production error telemetry (lightweight Sentry-analog).
# When set, the built app POSTs runtime errors to this URL
# (typically `${VITE_API_URL}/client-errors` → the API's
# POST /api/client-errors sink, which emits one structured log line).
# Unset = disabled (development never reports anything).
VITE_ERROR_REPORTING_URL=
# Optional build identifier attached to each report.
VITE_APP_RELEASE=

# AI copilot feature flags (off by default until a provider is configured).
VITE_AI_CONVERSATIONS_ENABLED=false
VITE_AI_INSIGHTS_ENABLED=false
VITE_AI_SUGGESTIONS_ENABLED=false
VITE_AI_STREAMING_ENABLED=false
