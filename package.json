{
  "name": "m-edu",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:packages": "turbo build --filter=\"./packages/*\"",
    "dev": "npm run build:packages && cross-env NODE_OPTIONS=--max-old-space-size=2048 turbo dev --filter=@medu/web --filter=@medu/api",
    "dev:web": "npm run dev -w @medu/web",
    "dev:api": "npm run build:packages && npm run dev -w @medu/api",
    "dev:all": "npm run build:packages && cross-env NODE_OPTIONS=--max-old-space-size=2048 turbo dev --concurrency=3",
    "db:dev": "npm run db:dev -w @medu/api",
    "build": "turbo build",
    "lint": "cross-env NODE_OPTIONS=--max-old-space-size=4096 turbo lint --concurrency=2",
    "test": "turbo test --concurrency=1",
    "test:integration": "npm run test:integration -w @medu/api",
    "test:e2e:web": "playwright test",
    "typecheck": "turbo typecheck",
    "test:e2e": "npm run test:e2e -w @medu/api",
    "db:generate": "cd apps/api && npx prisma generate",
    "db:push": "cd apps/api && npx prisma db push",
    "db:migrate": "cd apps/api && npx prisma migrate dev",
    "db:seed": "cd apps/api && npx prisma db seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "turbo": "^2.1.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.70.0"
  },
  "packageManager": "npm@10.2.0",
  "engines": {
    "node": ">=20.0.0 <22.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "multer": "^2.4.0",
    "lodash": "^4.18.1",
    "js-yaml": "^4.3.2",
    "qs": "^6.16.0",
    "uuid": "^11.1.1",
    "tmp": "^0.2.7",
    "picomatch": "^4.0.7",
    "file-type": "^21.3.4",
    "glob": "^10.5.0",
    "body-parser": "^1.20.8",
    "proxy-addr": "^2.0.8",
    "engine.io": "^6.6.11",
    "brace-expansion": "^1.1.21",
    "braces": "^3.0.3",
    "source-map-js": "^1.2.2",
    "@nestjs/platform-express": {
      "multer": "^2.4.0",
      "body-parser": "^1.20.8"
    },
    "express": {
      "qs": "^6.16.0",
      "body-parser": "^1.20.8",
      "proxy-addr": "^2.0.8"
    }
  },
  "version": "2.0.0"
}
