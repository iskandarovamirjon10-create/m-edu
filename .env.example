# M-EDU Development Environment Template
# Copy this file to .env and fill in real values for your local environment.
# NEVER commit .env — it is blocked by .gitignore.

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# --- Auth / JWT (must be >= 32 chars in production) ---
JWT_SECRET=changeme-please-set-at-least-32-characters-long
OAUTH_SESSION_SECRET=changeme-please-set-at-least-32-characters-long

# --- OAuth (Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Biometric / Camera encryption ---
BIOMETRIC_ENCRYPTION_KEY=changeme-please-set-at-least-32-characters-long
CAMERA_ENCRYPTION_KEY=changeme-please-set-at-least-32-characters-long

# --- URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# --- Server ---
PORT=3001

# --- Face recognition ---
# Set to "real-local" only when ONNX models are installed and licensed.
FACE_ENGINE_PROVIDER=mock-dev
# FACE_DETECTOR_MODEL_PATH=./models/face_detector.onnx
# FACE_EMBEDDER_MODEL_PATH=./models/face_embedder.onnx
# FACE_LIVENESS_MODEL_PATH=./models/face_liveness.onnx

# --- Email (optional) ---
# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
