# M-EDU Secrets — Dart-define configuration
# 
# Ishlatish:
#   flutter run --dart-define-from-file=.env
#   flutter build apk --dart-define-from-file=.env
#
# .env faylini .gitignore'da saqlang — hech qachon repo'ga tushirmang!
# CI/CD: GitHub Secrets yoki boshqa secrets manager orqali beriladi.

# Google OAuth Web Client ID (google-services.json → client_type: 3)
GOOGLE_WEB_CLIENT_ID=

# Firebase API Key (agar firebase_options.dart o'rniga ishlatilsa)
FIREBASE_API_KEY=

# Telegram Bot Token (ixtiyoriy — Telegram integratsiyasi uchun)
TELEGRAM_BOT_TOKEN=
