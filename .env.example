# M-EDU Development Environment Template
# Copy this file to .env and fill in real values for your local environment.
# NEVER commit .env — it is blocked by .gitignore.
#
# Full setup, database and Redis notes: docs/DEVELOPMENT.md
# Production checklist and migration procedure: docs/DEPLOYMENT.md

# --- Environment ---
# development | test | production. Explicit, never left unset:
# production turns on secure cookies, strict CORS, CSP/Helmet, disables
# Swagger and requires the real face engine plus every secret below.
NODE_ENV=development

# --- Database ---
# PostgreSQL 16 (canonical version — used by docker-compose, CI and the
# embedded test database). Production must use a UTF8 database (the
# migration chain creates pg_trgm trigram indexes and stores non-ASCII text).
# The chain expects the `pg_trgm` extension to be installable.
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# --- Auth / JWT (must be >= 32 chars in production) ---
JWT_SECRET=changeme-please-set-at-least-32-characters-long
# express-session signing secret for the Google OAuth flow. Required in
# production, and whenever GOOGLE_CLIENT_ID/SECRET are set.
OAUTH_SESSION_SECRET=changeme-please-set-at-least-32-characters-long

# --- OAuth (Google) ---
# Web application OAuth client from Google Cloud Console → APIs & Services → Credentials.
# Leave empty until real credentials exist — placeholders are treated as unconfigured.
# Authorized JavaScript origins:  http://localhost:3000
# Authorized redirect URIs:       http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# --- Biometric / Camera encryption (AES-256-GCM, >= 32 chars) ---
BIOMETRIC_ENCRYPTION_KEY=changeme-please-set-at-least-32-characters-long
CAMERA_ENCRYPTION_KEY=changeme-please-set-at-least-32-characters-long

# --- URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Server ---
PORT=3001

# --- Redis / BullMQ (notifications + scheduled background jobs) ---
# Redis is mandatory in production: it carries the notification event pipeline
# (`notification-events`) and every scheduled job (`background-jobs`). Startup
# validation refuses to boot production with REDIS_ENABLED=false or with no
# reachable host configured.
# REDIS_URL=redis://user:password@host:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# DEVELOPMENT ONLY: set to "false" on a machine with no Redis server. The
# notification pipeline and all cron jobs are then not registered at all and a
# warning is logged at boot. Never use this in production.
REDIS_ENABLED=true

# --- Face recognition ---
# The real ONNX engine (YuNet + SFace + MiniFASNet) is the ONLY provider that
# may serve recognition. "mock" is a test-only provider that fabricates a face
# for any image and always passes liveness; it is forbidden in production and
# must not be used at runtime.
FACE_ENGINE_PROVIDER=real-local
# Model paths (the bundled models are used when these are unset):
# FACE_DETECTOR_MODEL_PATH=./packages/face-engine/models/face_detection_yunet_2023mar.onnx
# FACE_EMBEDDER_MODEL_PATH=./packages/face-engine/models/face_recognition_sface_2021dec.onnx
# FACE_LIVENESS_MODEL_PATH=./packages/face-engine/models/minifasnet_v2.onnx

# --- Email (optional) ---
# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_USER=
# SMTP credentials. The unified env var is SMTP_PASSWORD — both the api's
# AuthService and EmailService read this exact name (SMTP_PASS was a
# mismatched alias that silently broke password-reset emails).
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="M-EDU Platform <no-reply@your-domain.uz>"

# --- Telegram bot (@medu_education_bot) ---
# The BotFather token is a BACKEND secret only. It must never be copied into
# the React app (no NEXT_PUBLIC_ prefix), never committed and never logged.
TELEGRAM_ENABLED=false
# BotFather token. Leave empty until real credentials exist; production startup
# refuses to boot when TELEGRAM_ENABLED=true and this is missing.
TELEGRAM_BOT_USERNAME=medu_education_bot
TELEGRAM_BOT_TOKEN=
# >=32 cryptographically random characters. Verified in constant time on every
# webhook delivery; the webhook fails closed (500) when it is not configured.
TELEGRAM_WEBHOOK_SECRET=changeme-please-set-at-least-32-characters-long
# Dedicated HMAC key for inline-keyboard callback envelopes. Falls back to
# JWT_SECRET when unset (a warning is logged) — a dedicated value is preferred.
TELEGRAM_CALLBACK_SECRET=changeme-please-set-at-least-32-characters-long
# Public HTTPS URL of this API's webhook endpoint, e.g.
# https://api.example.com/api/webhooks/telegram
# When set, the API registers it with Telegram (setWebhook + secret_token) at
# boot. Leave empty to register the webhook manually (see docs/TELEGRAM.md).
TELEGRAM_WEBHOOK_URL=
# Optional override of the Telegram Bot API host (self-hosted Bot API server
# or egress proxy). Defaults to the public API.
# TELEGRAM_API_BASE_URL=https://api.telegram.org
# Development only: simulate delivery without a real token.
# TELEGRAM_MOCK=false
# Retention for the webhook dedup table and expired link tokens (days).
# TELEGRAM_UPDATE_RETENTION_DAYS=7
# TELEGRAM_LINK_TOKEN_RETENTION_DAYS=7

AI_PROVIDER=
GEMINI_API_KEY=
TRUST_PROXY=
